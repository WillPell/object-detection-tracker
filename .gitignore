.venv/
__pycache__/
*.pyc

# Model weights are auto-downloaded on first run - never commit or ZIP these
*.pt
*.onnx
*.weights

# Generated outputs
output/*.mp4
output/frames/*.jpg
output/frames/*.png
output/*.csv
!output/.gitkeep
!output/frames/.gitkeep

# Assignment brief (Griffith IP) and generated report
*.pdf
*.docx

# Input video - goes in the submission ZIP, too big for GitHub
data/*.mp4
data/*.mov
data/*.MOV
!data/.gitkeep
